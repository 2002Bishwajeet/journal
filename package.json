{
  "name": "journal",
  "private": true,
  "version": "2.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "lint": "eslint .",
    "typecheck": "node node_modules/typescript-7/bin/tsc -b",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "mcp": "vite-node mcp/server.ts",
    "mcp:login": "vite-node mcp/server.ts login",
    "mcp:logout": "vite-node mcp/server.ts logout",
    "mcp:pack": "vite build -c mcp/vite.config.ts && npm pack ./mcp/package --pack-destination mcp",
    "e2e": "playwright test --project=hermetic",
    "e2e:dev": "E2E_SERVER=dev playwright test --project=hermetic",
    "e2e:live": "playwright test -c playwright.live.config.ts --project=live",
    "e2e:live:docker": "bash -c 'set -euo pipefail; export E2E_LIVE_IDENTITY=${E2E_LIVE_IDENTITY:-frodo.dotyou.cloud}; export E2E_CERT_DIR=e2e/.certs/live-docker/app; export E2E_LIVE_DOCKER=1; cleanup() { e2e/live/docker.sh down; rm -f e2e/.auth/live.json; }; trap cleanup EXIT; e2e/live/docker.sh up; npx playwright test -c playwright.live.config.ts --project=live-ci-setup; npx playwright test -c playwright.live.config.ts --project=live'",
    "e2e:login": "playwright test -c playwright.live.config.ts --project=live-setup --headed",
    "e2e:quarantine": "playwright test --project=quarantine --pass-with-no-tests",
    "e2e:report": "playwright show-report"
  },
