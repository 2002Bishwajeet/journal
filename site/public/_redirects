# Cloudflare Pages redirects. The landing site is the root; the app is under /app/ (#913).

# Old app links, from when the app was at /: the app's own paths (src/App.tsx) move to
# /app/. Pages keeps the query string. A user folder's id is not known here: an unknown
# path gets the landing page (there is no root 404.html), whose head script sends it to /app/.
/welcome          /app/welcome          301
/auth/finalize    /app/auth/finalize    301
/mcp/code         /app/mcp/code         301
/share-target     /app/share-target     301
/save-shared      /app/save-shared      301
/shared           /app/shared           301
/shared/*         /app/shared/:splat    301
# MAIN_FOLDER_ID and COLLABORATIVE_FOLDER_ID (src/lib/homebase/config.ts)
/06cf9262-4eae-4276-b0d1-8ca3cf5be6f4    /app/06cf9262-4eae-4276-b0d1-8ca3cf5be6f4    301
/06cf9262-4eae-4276-b0d1-8ca3cf5be6f4/*  /app/06cf9262-4eae-4276-b0d1-8ca3cf5be6f4/:splat  301
/fc360190-4e23-b870-0ea4-ef233aad98ad    /app/fc360190-4e23-b870-0ea4-ef233aad98ad    301
/fc360190-4e23-b870-0ea4-ef233aad98ad/*  /app/fc360190-4e23-b870-0ea4-ef233aad98ad/:splat  301

# No rewrite for the app's own routes: Pages applies a 200 rule even where a file exists, so
# /app/* would serve the shell for /app/sw.js too. The deploy copies the app's shell to
# app/404.html instead, which Pages serves (with status 404) for any path under /app/ with
# no file. /share/* is the share Function's (_routes.json).
