{
  "name": "@2002bishwajeet/live-blocks",
  "version": "0.1.0",
  "description": "Journal's live blocks (html, react, mermaid and svg code blocks) for any React host: sandboxed frames in Journal's look.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2002Bishwajeet/journal.git",
    "directory": "packages/live-blocks"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "default": "./dist/ui.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "vite build && node ../../node_modules/typescript-7/bin/tsc -p tsconfig.build.json",
    "test": "vitest run"
  },
  "dependencies": {
    "sucrase": "^3.35.1",
    "tailwindcss": "^4.3.3"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
