# The hosted Journal MCP (#1505) as a systemd *user* service. Install (as the unprivileged service user):
#   mkdir -p ~/journal-mcp/dist && cp mcp/dist/http.mjs ~/journal-mcp/dist/
#   cp mcp/deploy/journal-mcp.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now journal-mcp
#   loginctl enable-linger "$USER"   # keep it running with nobody logged in
# Grants live in ~/.local/state/journal-mcp/grants.sqlite (StateDirectory). Logs: journalctl --user -u journal-mcp
[Unit]
Description=Journal MCP (hosted) for mcp.cloudx.run/journal
After=network-online.target

[Service]
WorkingDirectory=%h/journal-mcp
ExecStart=/usr/bin/env node dist/http.mjs
Environment=PORT=8791
Environment=JOURNAL_MCP_ORIGIN=https://mcp.cloudx.run
Environment=JOURNAL_MCP_DB=%S/journal-mcp/grants.sqlite
StateDirectory=journal-mcp
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%S/journal-mcp

[Install]
WantedBy=default.target
