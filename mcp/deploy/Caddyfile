# The router for mcp.cloudx.run (#1505): its own Caddy, kept apart from /etc/caddy/Caddyfile, which another
# project owns. The Cloudflare Tunnel sends every request for mcp.cloudx.run here; each MCP gets its own
# handle blocks. Run it with mcp/deploy/mcp-router.service.
{
	# The system Caddy already has the admin endpoint (localhost:2019); restart this one to reload it.
	admin off
	auto_https off
}

:8780 {
	bind 127.0.0.1
	request_body {
		max_size 8MB
	}

	# Journal (mcp/hosted/main.ts): its own paths, and the two path-inserted discovery documents at the root.
	handle /journal/* {
		reverse_proxy 127.0.0.1:8791
	}
	handle /.well-known/oauth-protected-resource/journal/mcp {
		reverse_proxy 127.0.0.1:8791
	}
	handle /.well-known/oauth-authorization-server/journal {
		reverse_proxy 127.0.0.1:8791
	}

	# Another MCP: handle /<name>/* and its /.well-known/*/<name>… routes, to its own port.

	handle {
		respond 404
	}
}
