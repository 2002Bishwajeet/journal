# Environment for the hosted Journal MCP (keep the file mode 0600).
# Every value is optional: these are the defaults. The hosted Journal MCP needs no secrets.
#
# Port on 127.0.0.1; the reverse proxy forwards to it.
PORT=8781
# SQLite file for the OAuth grants, relative to the working directory (data/ is created 0700).
JOURNAL_MCP_DB=data/grants.sqlite
# Public origin every URL is built from (default https://mcp.cloudx.run).
# MCP_PUBLIC_ORIGIN=https://mcp.example.com
