# ~/.config/mcp-gateway/journal.env (mode 0600), read by the gateway's mcp@journal.service.
# Every value is optional: these are the defaults. The hosted Journal MCP needs no secrets.
#
# Port on 127.0.0.1, as registered in the mcp-gateway README.
PORT=8781
# SQLite file for the OAuth grants, relative to ~/services/mcp/journal/ (data/ is created 0700).
JOURNAL_MCP_DB=data/grants.sqlite
# MCP_PUBLIC_ORIGIN is set by mcp@.service (https://mcp.cloudx.run); don't set it here.
