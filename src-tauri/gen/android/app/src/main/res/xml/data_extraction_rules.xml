<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later. The database key's SharedPreferences file (db_key.rs, #1364) is
     encrypted with an Android Keystore key, which never leaves the phone, so it stays out of
     backups and transfers too. A restored phone then finds no key and offers the reset (#1362). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="keyring-default.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="keyring-default.xml" />
    </device-transfer>
</data-extraction-rules>
