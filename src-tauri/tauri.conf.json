{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Journal",
  "version": "2.69.0",
  "identifier": "com.biswa.journal",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "https://dev.dotyou.cloud:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM5MDY3NkQ3M0EzNjM0QUMKUldTc05EWTYxM1lHT1JuWTZsbEgyWnRWc0l0dWl3RkIzbFIxRXBUZ3ZvSDJBWEFINHJ2U05KRkkK",
      "endpoints": [
        "https://github.com/2002Bishwajeet/journal/releases/latest/download/latest.json"
      ]
    },
    "deep-link": {
      "mobile": [
        {
          "scheme": [
            "https"
          ],
          "host": "journal.cloudx.run",
          "pathPattern": [
            "/share/..*/..*"
          ],
          "path": [
            "/save-shared",
            "/open-shared"
          ],
          "appLink": true
        },
        {
          "scheme": [
            "journal"
          ],
          "appLink": false
        }
      ],
      "desktop": {
        "schemes": [
          "journal"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "iOS": {
      "minimumSystemVersion": "17.0",
      "developmentTeam": "N899Y9TW48"
    }
  }
}
