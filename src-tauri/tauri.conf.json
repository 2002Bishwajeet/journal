{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Journal",
  "version": "2.1.2",
  "identifier": "id.homebase.journal",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "https://dev.dotyou.cloud:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
