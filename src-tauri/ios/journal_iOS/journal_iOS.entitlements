<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Universal Links: journal.cloudx.run links open the app (paths in
	     public/.well-known/apple-app-site-association). The deep-link plugin's
	     build script writes the same entry from tauri.conf.json. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:journal.cloudx.run</string>
	</array>
</dict>
</plist>
