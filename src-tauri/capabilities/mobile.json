{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "mobile",
  "description": "External links and the sign-in open in an in-app browser.",
  "windows": ["main"],
  "platforms": ["iOS", "android"],
  "remote": {
    "urls": ["http://localhost:23941", "http://localhost:23942"]
  },
  "permissions": [
    "browser:default",
    { "identifier": "opener:allow-open-url", "allow": [{ "url": "itms-apps://**" }, { "url": "market://**" }] }
  ]
}
