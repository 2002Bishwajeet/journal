exports[`MCP tools/list > lists the same tools, titles, descriptions and input schemas as before the registry (#694) 1`] = `
[
  {
    "description": "List the folders you have granted this agent access to, in Journal.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {},
      "type": "object",
    },
    "name": "list_folders",
    "title": "List folders",
  },
  {
    "description": "List granted Journal notes, newest first. Optionally scoped to one folder. Each note has id, title, folderId and modified, or the \`fields\` you name, plus access "read" when it is read-only.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {
        "fields": {
          "items": {
            "enum": [
              "id",
              "title",
              "folderId",
              "modified",
              "tags",
            ],
            "type": "string",
          },
          "type": "array",
        },
        "folderId": {
          "type": "string",
        },
        "limit": {
          "maximum": 200,
          "minimum": 1,
          "type": "integer",
        },
      },
      "type": "object",
    },
    "name": "list_notes",
    "title": "List notes",
  },
  {
    "description": "Fetch one granted Journal note by id, with its body as markdown. With format "outline", the body is a list of top-level blocks { id, type, preview }: headings in full, other blocks cut to ~80 characters. With format "blocks", it is the blocks { id, type, markdown, attrs? }; give blockIds, or section (a heading's text: that heading and everything up to the next heading of its level or higher), to get only those, and includeRows for a table's cells as rows. The ids are the ones edit_block takes and stay the same while the block exists. To edit part of a long note, read its outline, then the section or blocks you change.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {
        "blockIds": {
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "format": {
          "enum": [
            "markdown",
            "outline",
            "blocks",
          ],
          "type": "string",
        },
        "id": {
          "type": "string",
        },
        "includeRows": {
          "type": "boolean",
        },
        "section": {
          "type": "string",
        },
      },
      "required": [
        "id",
      ],
      "type": "object",
    },
    "name": "get_note",
    "title": "Get note",
  },
  {
    "description": "Case-insensitive substring search over the title, tags and body of granted notes.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {
        "limit": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer",
        },
        "query": {
          "type": "string",
        },
      },
      "required": [
        "query",
      ],
      "type": "object",
    },
    "name": "search_notes",
    "title": "Search notes",
  },
  {
    "description": "The reference for writing Journal notes, in sections: every block a note can hold, with its markdown syntax and examples, how live blocks (mermaid, svg, html, react) run, and how to design them to match the note. With no section, an index of the sections; with a section, only that one.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {
        "section": {
          "enum": [
            "native",
            "editing",
            "mermaid-svg",
            "html",
            "react",
            "charts",
            "design",
            "examples",
          ],
          "type": "string",
        },
      },
      "type": "object",
    },
    "name": "get_authoring_guide",
    "title": "Get authoring guide",
  },
  {
    "description": "Create a Journal note from markdown in a folder you have granted Read+write access to. Supports rich blocks; call get_authoring_guide before writing a live block or an image.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {
        "folderId": {
          "type": "string",
        },
        "markdown": {
          "type": "string",
        },
        "tags": {
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "title": {
          "type": "string",
        },
      },
      "required": [
        "title",
        "markdown",
        "folderId",
      ],
      "type": "object",
    },
    "name": "create_note",
    "title": "Create note",
  },
  {
    "description": "Create a Journal folder. This agent gets Read+write access to it, so it can create notes there.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {
        "name": {
          "type": "string",
        },
      },
      "required": [
        "name",
      ],
      "type": "object",
    },
    "name": "create_folder",
    "title": "Create folder",
  },
  {
    "description": "Append markdown to the end of a Journal note with Read+write access. Merges with concurrent edits. Supports rich blocks; call get_authoring_guide before writing a live block or an image.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {
        "id": {
          "type": "string",
        },
        "markdown": {
          "type": "string",
        },
      },
      "required": [
        "id",
        "markdown",
      ],
      "type": "object",
    },
    "name": "append_to_note",
    "title": "Append to note",
  },
  {
    "description": "Replace one unique span of a Journal note's markdown (as returned by get_note) with new markdown. old_text must match exactly once; include surrounding text if it is ambiguous. Supports rich blocks; call get_authoring_guide before writing a live block or an image.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {
        "id": {
          "type": "string",
        },
        "new_text": {
          "type": "string",
        },
        "old_text": {
          "type": "string",
        },
      },
      "required": [
        "id",
        "old_text",
        "new_text",
      ],
      "type": "object",
    },
    "name": "replace_in_note",
    "title": "Replace in note",
  },
  {
    "description": "Rewrite a Journal note with Read+write access: its whole body as markdown, its title and/or its tags (tags replace the note's tags). Use it instead of creating a second note. Blocks you keep exactly as get_note returned them stay untouched, note links and images included. folderId moves the note to that folder, keeping its id, links and history; the folder may be read-only for you. Moving into a shared folder makes the note public, and out of one into a private folder makes it private. Pass \`modified\` from get_note or your last write as expectedModified to refuse the edit if the note changed since. Merges with concurrent edits. Supports rich blocks; call get_authoring_guide before writing a live block or an image.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {
        "expectedModified": {
          "type": "string",
        },
        "folderId": {
          "type": "string",
        },
        "id": {
          "type": "string",
        },
        "markdown": {
          "type": "string",
        },
        "tags": {
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "title": {
          "type": "string",
        },
      },
      "required": [
        "id",
      ],
      "type": "object",
    },
    "name": "update_note",
    "title": "Update note",
  },
  {
    "description": "Edit one block of a Journal note with Read+write access, by its id from get_note with format "blocks". Every other block is left as it is, and the edit merges with concurrent edits. op.type: replace, insert_before or insert_after (markdown); delete; set_text (a callout's or toggle's body, keeping its variant or summary); set_attrs (attrs: callout variant, toggle summary, heading level, code block language, id and wide, task list checked); and for a table, set_cell (row, col, markdown), insert_row (at, cells?), delete_row, insert_column and delete_column (at), which keep column widths and the other cells. Returns the ids of the blocks the op leaves and the note's new \`modified\`. Pass \`modified\` from get_note or your last write as expectedModified to refuse the edit if the note changed since. Supports rich blocks; call get_authoring_guide before writing a live block or an image.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {
        "block_id": {
          "type": "string",
        },
        "expectedModified": {
          "type": "string",
        },
        "note_id": {
          "type": "string",
        },
        "op": {
          "oneOf": [
            {
              "properties": {
                "markdown": {
                  "type": "string",
                },
                "type": {
                  "enum": [
                    "replace",
                    "insert_before",
                    "insert_after",
                    "set_text",
                  ],
                  "type": "string",
                },
              },
              "required": [
                "type",
                "markdown",
              ],
              "type": "object",
            },
            {
              "properties": {
                "type": {
                  "const": "delete",
                  "type": "string",
                },
              },
              "required": [
                "type",
              ],
              "type": "object",
            },
            {
              "properties": {
                "attrs": {
                  "properties": {
                    "checked": {
                      "items": {
                        "type": "boolean",
                      },
                      "type": "array",
                    },
                    "id": {
                      "type": [
                        "string",
                        "null",
                      ],
                    },
                    "language": {
                      "type": [
                        "string",
                        "null",
                      ],
                    },
                    "level": {
                      "maximum": 6,
                      "minimum": 1,
                      "type": "integer",
                    },
                    "summary": {
                      "type": "string",
                    },
                    "variant": {
                      "enum": [
                        "info",
                        "warning",
                        "tip",
                        "error",
                      ],
                      "type": "string",
                    },
                    "wide": {
                      "type": "boolean",
                    },
                  },
                  "type": "object",
                },
                "type": {
                  "const": "set_attrs",
                  "type": "string",
                },
              },
              "required": [
                "type",
                "attrs",
              ],
              "type": "object",
            },
            {
              "properties": {
                "col": {
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer",
                },
                "markdown": {
                  "type": "string",
                },
                "row": {
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer",
                },
                "type": {
                  "const": "set_cell",
                  "type": "string",
                },
              },
              "required": [
                "type",
                "row",
                "col",
                "markdown",
              ],
              "type": "object",
            },
            {
              "properties": {
                "at": {
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer",
                },
                "cells": {
                  "items": {
                    "type": "string",
                  },
                  "type": "array",
                },
                "type": {
                  "const": "insert_row",
                  "type": "string",
                },
              },
              "required": [
                "type",
                "at",
              ],
              "type": "object",
            },
            {
              "properties": {
                "at": {
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer",
                },
                "type": {
                  "enum": [
                    "delete_row",
                    "insert_column",
                    "delete_column",
                  ],
                  "type": "string",
                },
              },
              "required": [
                "type",
                "at",
              ],
              "type": "object",
            },
          ],
        },
      },
      "required": [
        "note_id",
        "block_id",
        "op",
      ],
      "type": "object",
    },
    "name": "edit_block",
    "title": "Edit block",
  },
  {
    "description": "Move a Journal note with Read+write access to Journal's Trash, where the owner can restore it. Never deletes permanently.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {
        "id": {
          "type": "string",
        },
      },
      "required": [
        "id",
      ],
      "type": "object",
    },
    "name": "delete_note",
    "title": "Delete note",
  },
  {
    "description": "Set the cover image of a Journal note with Read+write access, replacing its cover. \`image\` is an absolute path to a file on this computer (preferred: it costs no tokens) or a base64 \`data:\` URI. PNG, JPEG or WebP, at most 5 MB; metadata such as EXIF and GPS is removed before upload. Recommended size 2400×1260, at least 1200×630. The image is uploaded as is (not resized): crop it to about 1.9:1 and resize it to 2400×1260 first; the result has a \`note\` when it is too small or the wrong shape. \`positionY\` is the vertical focal point, 0 (top) to 100 (bottom), default 50. \`dark: true\` sets the cover shown in dark mode instead; the note must already have a cover. Use this rather than an image in an html block: the cover also feeds the link preview of a public note.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {
        "dark": {
          "type": "boolean",
        },
        "id": {
          "type": "string",
        },
        "image": {
          "type": "string",
        },
        "positionY": {
          "maximum": 100,
          "minimum": 0,
          "type": "number",
        },
      },
      "required": [
        "id",
        "image",
      ],
      "type": "object",
    },
    "name": "set_note_cover",
    "title": "Set note cover",
  },
  {
    "description": "Remove the cover image of a Journal note with Read+write access. This removes the dark-mode cover too; with \`dark: true\` only the dark-mode cover is removed.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {
        "dark": {
          "type": "boolean",
        },
        "id": {
          "type": "string",
        },
      },
      "required": [
        "id",
      ],
      "type": "object",
    },
    "name": "clear_note_cover",
    "title": "Clear note cover",
  },
]
`;
